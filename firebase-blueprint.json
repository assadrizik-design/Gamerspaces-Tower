{
  "entities": {
    "LeaderboardEntry": {
      "title": "LeaderboardEntry",
      "description": "An entry representing a player's score on the leaderboard.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the player"
        },
        "score": {
          "type": "number",
          "description": "The score achieved by the player"
        },
        "updatedAt": {
          "type": "timestamp"
        }
      },
      "required": ["name", "score"]
    }
  },
  "firestore": {
    "leaderboard/{entryId}": {
      "schema": {
        "$ref": "#/entities/LeaderboardEntry"
      },
      "description": "Global leaderboard for players."
    }
  }
}
