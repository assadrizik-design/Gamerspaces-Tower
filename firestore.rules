rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} { 
      allow read, write: if false; 
    }
    
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    // We'll allow anonymous sign in 
    function isSignedIn() { return request.auth != null; }

    function isValidLeaderboardEntry(data) {
      return data.keys().size() == 4 
        && data.keys().hasAll(['name', 'score', 'userId', 'updatedAt'])
        && data.name is string 
        && data.name.size() > 0 
        && data.name.size() <= 60
        && data.score is number
        && data.score >= 0
        && data.userId is string
        && data.userId == request.auth.uid
        && data.updatedAt == request.time;
    }

    match /leaderboard/{entryId} {
      allow create: if isSignedIn() 
        && isValidId(entryId) 
        && isValidLeaderboardEntry(incoming())
        && entryId == request.auth.uid;
      
      allow update: if isSignedIn() 
        && isValidId(entryId)
        && entryId == request.auth.uid
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'score', 'updatedAt', 'userId'])
        && incoming().get('userId', existing().userId) == existing().userId
        && incoming().score >= existing().score
        && incoming().name is string
        && incoming().name.size() > 0
        && incoming().name.size() <= 60
        && incoming().updatedAt == request.time;
      
      allow get: if isSignedIn();

      allow list: if isSignedIn() && resource.data.score >= 0;
    }
  }
}
